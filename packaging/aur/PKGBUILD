# AUR: fold-rs-git
# Maintainer: AmazingCoderA
pkgname=fold-rs-git
pkgver=0.1.0.r1.g0
pkgrel=2
pkgdesc="Rust port of the 2007 Fold seismic structural-map program (CLI + GUI)"
arch=('x86_64' 'aarch64')
url="https://github.com/AmazingCoderA/fold-rs"
license=('custom:unknown')
depends=('gcc-libs' 'libgl' 'libx11' 'libxkbcommon' 'wayland' 'libxi')
makedepends=('git' 'cargo' 'rust' 'pkgconf')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/fold-rs"
  git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/fold-rs"
  cargo build --release --locked --bins
}

check() {
  cd "$srcdir/fold-rs"
  cargo test --release --locked
}

package() {
  cd "$srcdir/fold-rs"
  install -Dm755 target/release/fold "$pkgdir/usr/bin/fold"
  install -Dm755 target/release/fold-gui "$pkgdir/usr/bin/fold-gui"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
